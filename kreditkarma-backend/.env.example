# ============================================================================
# XRPLHub.io — environment variables
# Copy to .env for local dev. In production these live in the Vercel project
# (Production + Preview). Keep this file in sync with what the app actually
# reads (grep `process.env.` in src/) — it is the single source of truth for
# env var names.
# ============================================================================

# ─── XRPL network ───────────────────────────────────────────────────────────
# WebSocket endpoint used by the scoring engine, checkout payment matching and
# treasury service. Public cluster is fine to start.
XRPL_ENDPOINT=wss://xrplcluster.com
# Node URL used by the treasury multi-sig service + setup scripts. Point at the
# SAME network as XRPL_ENDPOINT (mainnet for production).
XRPL_NODE_URL=wss://xrplcluster.com
# Local dev / testnet alternative:
# XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233
# XRPL_NODE_URL=wss://s.altnet.rippletest.net:51233

# ─── Database (Neon Postgres via Prisma) ────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── B2B API / admin ────────────────────────────────────────────────────────
# Long random string. Gates POST /api/keys and every /api/admin + ops route.
# Generate:  openssl rand -base64 32
ADMIN_API_TOKEN=

# ─── Xaman (XUMM) signing ───────────────────────────────────────────────────
# Same credentials used for transaction-service signing and checkout connect.
# From https://apps.xumm.dev
XUMM_API_KEY=
XUMM_API_SECRET=

# ─── RLUSD ──────────────────────────────────────────────────────────────────
# Ripple's OFFICIAL RLUSD mainnet issuer. Do NOT use an xrpl.org tutorial
# address here. Code falls back to this exact value if the var is unset, but
# set it explicitly so the fallback is never load-bearing.
RLUSD_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De
# 40-char hex for "RLUSD" (the string "RLUSD" is 5 chars and will not
# serialize). Right-padded with zeros.
RLUSD_CURRENCY=524C555344000000000000000000000000000000

# ─── Treasury multi-sig (grant payouts + donations) ─────────────────────────
# The wallet that receives service payments and funds grants. Also carries the
# on-ledger "XRPLHub" label. This is NOT the RLUSD issuer, and NOT any future
# credential issuer.
TREASURY_ADDRESS=rs59g3amo5iT6T64Cg96XXMAWuw3WPQcLF
# Signer seeds for the N-of-M signer list. 1 and 2 required, 3 optional.
TREASURY_SIGNER_1_SEED=
TREASURY_SIGNER_2_SEED=
TREASURY_SIGNER_3_SEED=
TREASURY_QUORUM=2
# Master seed — ONLY for scripts/setup-multisig.js (one-time). Leave unset in
# the app runtime.
# TREASURY_MASTER_SEED=

# ─── Grant limits ──────────────────────────────────────────────────────────
GRANT_MAX_AMOUNT_XRP=100
GRANT_MAX_AMOUNT_RLUSD=50
GRANT_DAILY_LIMIT_USD=1000

# ─── AI grant review ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional Grok fallback (either name is read; XAI_API_KEY preferred):
# XAI_API_KEY=xai-...
# GROK_API_KEY=xai-...

# ─── x402 (pay-per-call API over RLUSD) ────────────────────────────────────
# Optional — sane defaults apply if unset.
# X402_FACILITATOR_URL=
# X402_NETWORK=xrpl
# X402_SOURCE_TAG=

# ─── Paid certificates ─────────────────────────────────────────────────────
# HMAC secret for signing verification-page certificate tokens (NOT an XRPL key).
CREDENTIAL_SIGNING_SECRET=

# ─── App / misc ────────────────────────────────────────────────────────────
# Public origin used to build absolute URLs (certificates, OpenAPI, emails).
PUBLIC_ORIGIN=https://www.xrplhub.io
NEXT_PUBLIC_API_URL=https://www.xrplhub.io
# Optional: outbound email (Resend) and error webhook.
# RESEND_API_KEY=
# ERROR_WEBHOOK_URL=

# Bithomp API key — free tier (bithomp.com/admin -> API). Used by
# GET /api/mpt/:issuanceId for the MPT-index cross-check. Optional.
BITHOMP_API_KEY=
