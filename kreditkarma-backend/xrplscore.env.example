# ============================================================
# XRPLScore — env vars to ADD to your project (do not delete
# your existing vars). Add these in Vercel too (Prod + Preview).
# ============================================================

# Long random string used to mint API keys via POST /api/keys.
# Generate one:  openssl rand -base64 32
ADMIN_API_TOKEN=""

# Your treasury wallet — the one that ALREADY holds RLUSD. NOT the issuer.
# (You may already have this under another name in your app — reuse if so.)
TREASURY_ADDRESS=""

# Ripple's official RLUSD mainnet issuer. Leave as-is.
RLUSD_ISSUER="rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De"

# XRPL node. Public cluster is fine to start.
XRPL_ENDPOINT="wss://xrplcluster.com"

# DATABASE_URL — you already have this (Neon). Nothing to change.
