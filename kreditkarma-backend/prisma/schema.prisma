// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LedgerScore {
  id            String         @id @default(cuid())
  address       String         @unique
  score         Int            // 300–850
  tier          String         // POOR / FAIR / GOOD / EXCELLENT
  breakdown     String         // JSON: { accountAge, txVolume, ammLp, ... }
  rawData       String         // JSON: full on-chain snapshot
  calculatedAt  DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  grants        GrantRequest[]

  @@index([address])
}

// ─── NEW: every individual score check, for progress-over-time tracking ──────
model ScoreHistory {
  id          String   @id @default(cuid())
  address     String
  score       Int      // 300–850
  tier        String   // Building / Fair / Good / Excellent / Exceptional
  percentile  Int?     // peer percentile at time of check
  breakdown   String?  // JSON snapshot of the 8 signals
  checkedAt   DateTime @default(now())

  @@index([address])
  @@index([checkedAt])
}

model GrantRequest {
  id                String        @id @default(cuid())
  walletAddress     String
  category          String        // RENT / UTILITIES / GROCERIES / MEDICAL / OTHER
  amountRequested   Float         // in USD equivalent
  currency          String        @default("RLUSD")
  description       String
  urgency           String        // LOW / MEDIUM / HIGH / EMERGENCY

  // AI Underwriting
  aiScore           Float?
  aiReasoning       String?
  riskFlags         String?       // JSON array of flags
  approvedAmount    Float?

  // Status lifecycle
  status            String        @default("PENDING")   // PENDING → REVIEWING → APPROVED / REJECTED → PAID / FAILED

  // Payout
  txHash            String?
  paidAt            DateTime?
  paidAmount        Float?

  // Scoring context
  ledgerScoreId     String?
  ledgerScore       LedgerScore?  @relation(fields: [ledgerScoreId], references: [id])
  scoreSnapshot     Int?
  reviewedBy        String?       // "AI" or admin address
  rejectionReason   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([walletAddress])
  @@index([status])
  @@index([createdAt])
}

model ScoreCredential {
  id            String    @id @default(cuid())
  certId        String    @unique
  walletAddress String
  score         Int
  grade         String
  percentile    Int?
  signature     String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  amountPaid    String
  currency      String    @default("XRP")
  txHash        String?   @unique
  paymentUuid   String?
  status        String    @default("PENDING")
  revoked       Boolean   @default(false)
  verifyCount   Int       @default(0)

  @@index([walletAddress])
  @@index([certId])
  @@index([status])
}

model Purchase {
  id            String    @id @default(cuid())
  productId     String
  currency      String    @default("XRP")
  amount        String
  email         String?
  wallet        String?
  txHash        String?   @unique
  serviceTxHash String?
  status        String    @default("VERIFIED")
  verifiedAt    DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([txHash])
  @@index([wallet])
}

model Donation {
  id          String   @id @default(cuid())
  fromAddress String
  amount      Float
  currency    String   // XRP or RLUSD
  txHash      String   @unique
  message     String?
  createdAt   DateTime @default(now())
}

model DailyLimit {
  id          String   @id @default(cuid())
  date        String   @unique   // YYYY-MM-DD
  totalPaid   Float    @default(0)
  grantCount  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  target    String?
  details   String?  // JSON
  createdAt DateTime @default(now())
}

// prisma/schema.additions.prisma
// APPEND these models to your existing schema.prisma. Do NOT replace the
// file — your existing models stay untouched. Then run:
//   npx prisma migrate dev --name xrplscore_billing
//   npx prisma generate

// -------- API keys ---------------------------------------------------------
model ApiKey {
  id          String        @id @default(cuid())
  keyPrefix   String        @unique              // first 16 chars, indexed lookup
  keyHash     String                              // sha256 of full key; raw never stored
  name        String?
  plan        String        @default("free")      // "free" | "starter" | "growth" | "scale"
  active      Boolean       @default(true)
  ownerWallet String?       @unique               // set only for self-serve free keys — one per XRPL wallet
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  usage       UsageRecord[]
  invoices    Invoice[]

  @@index([keyPrefix])
}

// -------- Self-serve free-key signup log (rate-limit source of truth) ------
model FreeKeySignup {
  id        String   @id @default(cuid())
  ip        String
  wallet    String?                              // set on a successful claim
  step      String                               // "start" (SignIn payload created) | "claim" (key issued)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// -------- SignIn challenge for injected wallets (Crossmark / GemWallet) ----
// The wallet signs `hex`; the server verifies the signature recovers to the
// claimed address. Single-use (consumedAt) + short TTL — a replayable
// challenge is a free-key farm.
model SignInChallenge {
  id         String    @id @default(cuid())
  hex        String    @unique               // 32 random bytes, hex — what the wallet signs
  ip         String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([createdAt])
}

// -------- Usage (also the billing signal) ----------------------------------
model UsageRecord {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint  String                               // "score", etc.
  windowKey String                               // month bucket, e.g. "2026-08"
  overage   Boolean  @default(false)             // true = billable overage call
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])                  // per-minute rate limit
  @@index([apiKeyId, windowKey])                  // monthly quota + billing
}

// -------- Checkout invoices -------------------------------------------------
model Invoice {
  id             String    @id @default(cuid())
  plan           String                            // plan being purchased
  amountRlusd    Decimal   @db.Decimal(20, 6)      // USD-denominated price (always set)
  currency       String    @default("RLUSD")       // RLUSD | XRP — what the buyer pays in
  amountXrp      Decimal?  @db.Decimal(20, 6)      // exact XRP to charge (XRP invoices)
  xrpUsdRate     Decimal?  @db.Decimal(20, 6)      // XRP/USD rate locked at quote time
  destinationTag Int       @unique                 // 32-bit; one per invoice
  status         String    @default("pending")     // pending | paid | expired
  txHash         String?                            // set when matched on-ledger
  deliveredRlusd Decimal?  @db.Decimal(20, 6)      // RLUSD that actually arrived
  deliveredXrp   Decimal?  @db.Decimal(20, 6)      // XRP that actually arrived
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  apiKeyId       String?                            // key issued on payment
  apiKey         ApiKey?   @relation(fields: [apiKeyId], references: [id])

  @@index([destinationTag])
  @@index([status])
}

// ── XRPL credential explorer — network-wide census of Credential objects ──────
// Populated by the scheduled indexer (src/lib/credentialIndexer.ts, triggered by
// /api/cron/index-credentials) and scripts/census-credentials.cjs (hand-run).
// Read by GET /api/credentials/issuer (aggregate/issuer lookups — staleness is
// fine there). NOT read by GET /api/credentials/account or
// GET /api/domains/eligible — those hit the ledger live on every request,
// deliberately, because a stale answer there means a revoked credential could
// read as valid.
model IndexedCredential {
  id               String    @id @default(cuid())
  objectIndex      String    @unique // the Credential ledger object's own 256-bit index — canonical id
  issuer           String
  subject          String
  credentialType   String                              // hex
  accepted         Boolean
  expirationRipple Int?                                 // ripple-epoch seconds; null = never expires
  uri              String?
  passNumber       Int                                  // last indexer pass that re-confirmed this row present
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @updatedAt

  @@index([issuer])
  @@index([subject])
}

// Singleton row (id: "credential") tracking the indexer's walk position and
// whether a full pass has ever completed — the coverage signal
// GET /api/credentials/issuer must surface rather than presenting a partial
// walk as a complete census.
model IndexerCheckpoint {
  id                      String    @id @default("credential")
  status                  String    @default("idle") // idle | running — explicit, not inferred from marker
  marker                  String?   // current ledger_data pagination marker; null before the first page of a pass
  passNumber              Int       @default(0) // increments each time a NEW pass starts
  passStartedAt           DateTime?
  lastCompletedPassAt     DateTime?
  lastCompletedPassNumber Int?
  lastLedgerCloseTime     Int?      // ripple-epoch seconds observed during the most recent run —
                                    // the "now" used for expiry math on the INDEXED (not live) endpoint
  updatedAt               DateTime  @updatedAt
}
