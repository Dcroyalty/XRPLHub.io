// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LedgerScore {
  id            String         @id @default(cuid())
  address       String         @unique
  score         Int            // 300–850
  tier          String         // Building / Fair / Good / Excellent / Exceptional
  breakdown     String         // JSON: the 8 signal scores
  rawData       String         // JSON: XrplScoreDetails snapshot
  resultJson    String?        // JSON: the FULL XrplScoreResult — the 15-min display cache payload
  scoredAt      DateTime?      // when resultJson's RPC data was fetched (the cache freshness clock)
  calculatedAt  DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  grants        GrantRequest[]

  @@index([address])
}

// Immutable per-address facts. An account's first transaction is its funding
// tx — it can never change — so this row NEVER expires. Removes the
// account_tx{limit:1,forward:true} call on every re-score of a known address.
model XrplFactCache {
  address       String   @id
  firstTxLedger Int?
  firstTxDate   Int?     // Ripple-epoch seconds
  firstSeenAt   DateTime @default(now())
}

// Lightweight call counters — one row per (UTC day, method). `method` is an
// XRPL method (account_info, account_tx, ...) or a pseudo-metric
// (cache:hit, cache:miss, node:<host>). Enough to see if we approach a quota.
model XrplCallStat {
  id     String @id @default(cuid())
  day    String // YYYY-MM-DD (UTC)
  method String
  calls  Int    @default(0)

  @@unique([day, method])
}

// ─── NEW: every individual score check, for progress-over-time tracking ──────
model ScoreHistory {
  id          String   @id @default(cuid())
  address     String
  score       Int      // 300–850
  tier        String   // Building / Fair / Good / Excellent / Exceptional
  percentile  Int?     // peer percentile at time of check
  breakdown   String?  // JSON snapshot of the 8 signals
  checkedAt   DateTime @default(now())

  @@index([address])
  @@index([checkedAt])
}

model GrantRequest {
  id                String        @id @default(cuid())
  walletAddress     String
  category          String        // RENT / UTILITIES / GROCERIES / MEDICAL / OTHER
  amountRequested   Float         // in USD equivalent
  currency          String        @default("RLUSD")
  description       String
  urgency           String        // LOW / MEDIUM / HIGH / EMERGENCY

  // AI Underwriting
  aiScore           Float?
  aiReasoning       String?
  riskFlags         String?       // JSON array of flags
  approvedAmount    Float?

  // Status lifecycle
  status            String        @default("PENDING")   // PENDING → REVIEWING → APPROVED / REJECTED → PAID / FAILED

  // Payout
  txHash            String?
  paidAt            DateTime?
  paidAmount        Float?

  // Scoring context
  ledgerScoreId     String?
  ledgerScore       LedgerScore?  @relation(fields: [ledgerScoreId], references: [id])
  scoreSnapshot     Int?
  reviewedBy        String?       // "AI" or admin address
  rejectionReason   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([walletAddress])
  @@index([status])
  @@index([createdAt])
}

model ScoreCredential {
  id            String    @id @default(cuid())
  certId        String    @unique
  walletAddress String
  score         Int
  grade         String
  percentile    Int?
  signature     String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  amountPaid    String
  currency      String    @default("XRP")
  txHash        String?   @unique
  paymentUuid   String?
  status        String    @default("PENDING")
  revoked       Boolean   @default(false)
  verifyCount   Int       @default(0)

  @@index([walletAddress])
  @@index([certId])
  @@index([status])
}

model Purchase {
  id            String    @id @default(cuid())
  productId     String
  currency      String    @default("XRP")
  amount        String
  email         String?
  wallet        String?
  txHash        String?   @unique
  serviceTxHash String?
  status        String    @default("VERIFIED")
  verifiedAt    DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([txHash])
  @@index([wallet])
}

model Donation {
  id          String   @id @default(cuid())
  fromAddress String
  amount      Float
  currency    String   // XRP or RLUSD
  txHash      String   @unique
  message     String?
  createdAt   DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  target    String?
  details   String?  // JSON
  createdAt DateTime @default(now())
}

// prisma/schema.additions.prisma
// APPEND these models to your existing schema.prisma. Do NOT replace the
// file — your existing models stay untouched. Then run:
//   npx prisma migrate dev --name xrplscore_billing
//   npx prisma generate

// -------- API keys ---------------------------------------------------------
model ApiKey {
  id          String        @id @default(cuid())
  keyPrefix   String        @unique              // first 16 chars, indexed lookup
  keyHash     String                              // sha256 of full key; raw never stored
  name        String?
  plan        String        @default("free")      // "free" | "starter" | "growth" | "scale"
  active      Boolean       @default(true)
  expiresAt   DateTime?                            // paid keys: paidAt + PLAN_KEY_TTL_DAYS. null = never expires (free + admin keys)
  ownerWallet String?       @unique               // set only for self-serve free keys — one per XRPL wallet
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  usage       UsageRecord[]
  invoices    Invoice[]

  @@index([keyPrefix])
}

// -------- Self-serve free-key signup log (rate-limit source of truth) ------
model FreeKeySignup {
  id        String   @id @default(cuid())
  ip        String
  wallet    String?                              // set on a successful claim
  step      String                               // "start" (SignIn payload created) | "claim" (key issued)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// -------- SignIn challenge for injected wallets (Crossmark / GemWallet) ----
// The wallet signs `hex`; the server verifies the signature recovers to the
// claimed address. Single-use (consumedAt) + short TTL — a replayable
// challenge is a free-key farm.
model SignInChallenge {
  id         String    @id @default(cuid())
  hex        String    @unique               // 32 random bytes, hex — what the wallet signs
  ip         String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([createdAt])
}

// -------- x402 paid-request idempotency -----------------------------------
// One row per paid call on the RLUSD/t54 routes, keyed by the caller's
// Idempotency-Key header (or, absent that, the payment's invoiceId). A
// retrying agent that isn't sure its first call landed gets the SAME stored
// response back instead of paying again. See src/lib/x402.ts serveX402Paid().
model X402PaidRequest {
  key         String    @id                 // Idempotency-Key header, else the payload invoiceId
  resource    String                        // "/api/x402/score" etc.
  invoiceId   String
  status      String    @default("in_progress") // in_progress | completed | failed
  settled     Boolean   @default(false)
  txHash      String?
  responseJson Json?                         // the exact success body to replay
  httpStatus  Int?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

// -------- Usage (also the billing signal) ----------------------------------
model UsageRecord {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint  String                               // "score", etc.
  windowKey String                               // month bucket, e.g. "2026-08"
  overage   Boolean  @default(false)             // true = billable overage call
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])                  // per-minute rate limit
  @@index([apiKeyId, windowKey])                  // monthly quota + billing
}

// -------- Checkout invoices -------------------------------------------------
model Invoice {
  id             String    @id @default(cuid())
  plan           String                            // plan being purchased
  amountRlusd    Decimal   @db.Decimal(20, 6)      // USD-denominated price (always set)
  currency       String    @default("RLUSD")       // RLUSD | XRP — what the buyer pays in
  amountXrp      Decimal?  @db.Decimal(20, 6)      // exact XRP to charge (XRP invoices)
  xrpUsdRate     Decimal?  @db.Decimal(20, 6)      // XRP/USD rate locked at quote time
  destinationTag Int       @unique                 // 32-bit; one per invoice
  status         String    @default("pending")     // pending | paid | expired
  txHash         String?                            // set when matched on-ledger
  deliveredRlusd Decimal?  @db.Decimal(20, 6)      // RLUSD that actually arrived
  deliveredXrp   Decimal?  @db.Decimal(20, 6)      // XRP that actually arrived
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  apiKeyId       String?                            // key issued on payment
  apiKey         ApiKey?   @relation(fields: [apiKeyId], references: [id])

  @@index([destinationTag])
  @@index([status])
}

// ── XRPL credential explorer — network-wide census of Credential objects ──────
// Populated by the scheduled indexer (src/lib/credentialIndexer.ts, triggered by
// /api/cron/index-credentials) and scripts/census-credentials.cjs (hand-run).
// Read by GET /api/credentials/issuer (aggregate/issuer lookups — staleness is
// fine there). NOT read by GET /api/credentials/account or
// GET /api/domains/eligible — those hit the ledger live on every request,
// deliberately, because a stale answer there means a revoked credential could
// read as valid.
model IndexedCredential {
  id               String    @id @default(cuid())
  objectIndex      String    @unique // the Credential ledger object's own 256-bit index — canonical id
  issuer           String
  subject          String
  credentialType   String                              // hex
  accepted         Boolean
  expirationRipple Int?                                 // ripple-epoch seconds; null = never expires
  uri              String?
  passNumber       Int                                  // last indexer pass that re-confirmed this row present
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @updatedAt

  @@index([issuer])
  @@index([subject])
}

// One row per indexed MPTokenIssuance (XLS-33). The union of two sources:
// our own ledger_data walk (authoritative for existence, slow to complete a
// full pass) and Bithomp's per-issuer index (fast, complete per issuer, only
// covers issuers we already know to ask about). `sources` records which of
// the two last confirmed the row. Backs GET /api/mpt/search and
// GET /api/mpt/issuer — both of which must surface `coverage` from the "mpt"
// IndexerCheckpoint row, never presenting a partial walk as a full census.
model IndexedMPT {
  id          String   @id @default(cuid())
  issuanceId  String   @unique          // 48-hex MPTokenIssuanceID — canonical
  issuer      String
  sequence    Int?                       // creating-tx Sequence
  assetScale  Int      @default(0)
  maxAmount   String?                    // MaximumAmount (uint64 as string); null = unlimited
  outstanding String   @default("0")
  transferFee Int      @default(0)       // raw TransferFee (tenths of a basis point)
  flagsRaw    Int      @default(0)
  metadata    String?                    // decoded MPTokenMetadata (JSON string, or raw text if not JSON)
  name        String?                    // best-effort display name from the metadata
  ticker      String?                    // metadata ticker / currency code, if any
  searchText  String?                    // lowercased "name ticker currency" blob for case-insensitive search
  holderCount Int?                       // null = unknown
  ledgerIndex Int?                       // validated ledger the walk last confirmed this row against
  sources     String   @default("")      // comma-separated: "walk", "bithomp"
  passNumber  Int      @default(0)       // last walk pass that re-confirmed this row (0 = never seen by the walk)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([issuer])
  @@index([searchText])
}

// Per-issuer aggregate for GET /api/mpt/issuer — how many MPTs the issuer has
// out and the issuer's own XRPLScore. Rescored by the cron whenever the
// issuer's set of issuance ids changes (issuanceIdsHash).
model IndexedMptIssuer {
  issuer          String    @id
  mptCount        Int       @default(0)
  issuanceIdsHash String?                // sha256 of the sorted issuanceId list — cheap change detector
  xrplScore       Int?
  grade           String?
  domain          String?
  blackholed      Boolean   @default(false)
  bithompCapped   Boolean   @default(false) // issuer has >100 issuances — Bithomp free tier can't page past 100,
                                            // so our count is a floor and coverage can't be "complete-per-known-issuer"
  scoredAt        DateTime?
  lastRefreshedAt DateTime  @updatedAt
}

// One row per on-ledger anchor of the MPT registry (BIS WP 1374 pattern): a
// Merkle root over the canonicalised index, committed in a Memo on a
// transaction from the issuer wallet, so a third party can prove the registry
// wasn't altered after the fact. See src/lib/mptAnchor.ts for the exact
// canonicalisation + Merkle scheme (also echoed in GET /api/mpt/anchor).
model MptAnchor {
  id            String    @id @default(cuid())
  canonVersion  String                     // e.g. "mpt-anchor-v1" — the canonicalisation algo id
  merkleRoot    String                     // 64-hex SHA-256 Merkle root
  issuanceCount Int
  issuerCount   Int
  coverage      String                     // "complete-per-known-issuer" | "partial"
  freshnessFloorAt DateTime?               // oldest per-issuer refresh folded into this snapshot
  memo          String                     // the exact UTF-8 memo payload written on-ledger
  txHash        String?   @unique          // set once the anchor tx validates
  ledgerIndex   Int?
  account       String?                    // signing account (the issuer wallet)
  feeDrops      String?
  status        String    @default("pending") // pending | anchored | failed
  error         String?
  createdAt     DateTime  @default(now())
  anchoredAt    DateTime?

  @@index([createdAt])
  @@index([status])
}

// Singleton-per-id row tracking an indexer's walk position and whether a full
// pass has ever completed — the coverage signal the read endpoints must
// surface rather than presenting a partial walk as a complete census.
// id "credential" → the Credential census; id "mpt" → the MPTokenIssuance census.
model IndexerCheckpoint {
  id                      String    @id @default("credential")
  status                  String    @default("idle") // idle | running — explicit, not inferred from marker
  marker                  String?   // current ledger_data pagination marker; null before the first page of a pass
  passNumber              Int       @default(0) // increments each time a NEW pass starts
  passStartedAt           DateTime?
  lastCompletedPassAt     DateTime?
  lastCompletedPassNumber Int?
  lastLedgerCloseTime     Int?      // ripple-epoch seconds observed during the most recent run —
                                    // the "now" used for expiry math on the INDEXED (not live) endpoint
  updatedAt               DateTime  @updatedAt
}

// ─── OFAC SDN screening — snapshots, extracted addresses, receipts, anchors ────
// A screening receipt attests to PROCESS, never ground truth: "XRPL address X
// was compared against OFAC-SDN snapshot V at time T; result R." It never says
// "X is sanctioned" or "X is clean". Canonicalisation is frozen under
// canonVersion "ofac-screen-v1" (src/lib/screenCanon.ts) and echoed by
// GET /api/attest/anchor. Snapshots, receipts and the Merkle inputs are the
// product — APPEND-ONLY, never pruned.

// One immutable capture of the OFAC SDN list. `sha256` is over `canonicalArchive`
// (the normalised JSON), so a third party can reproduce it. Written only when the
// content hash changes AND the parse produced a sane XRP-address count.
model SanctionListSnapshot {
  id               String   @id @default(cuid())
  listName         String                       // "OFAC-SDN"
  vintage          String                       // OFAC Publish_Date as ISO (YYYY-MM-DD)
  publishRaw       String                       // the Publish_Date string exactly as OFAC wrote it
  recordCount      Int                          // OFAC Record_Count for the whole list
  addressCount     Int                          // XRP addresses we extracted
  sha256           String                       // hex SHA-256 of canonicalArchive
  sourceUrl        String
  fetchedAt        DateTime @default(now())
  canonicalArchive Json                         // full normalised snapshot — retained forever
  createdAt        DateTime @default(now())

  addresses        SanctionedAddress[]

  @@unique([listName, sha256])
  @@index([listName, fetchedAt])
}

// One XRP address extracted from one snapshot. Per-snapshot rows, never deleted —
// history is the full set of snapshots + their address rows.
model SanctionedAddress {
  id           String   @id @default(cuid())
  snapshotId   String
  snapshot     SanctionListSnapshot @relation(fields: [snapshotId], references: [id])
  listName     String                          // "OFAC-SDN"
  address      String                          // XRPL r-address, verbatim from the list
  entryId      String                          // OFAC sdnEntry uid
  entryName    String                          // the sdnEntry's own listed name
  programs     String                          // comma-joined sanctions programs, e.g. "CYBER2"
  addressField String                          // "Digital Currency Address - XRP"
  idUid        String                          // the <id> element uid
  createdAt    DateTime @default(now())

  @@index([snapshotId])
  @@index([listName, address])
}

// One screening receipt. `leafHash` is SHA-256(0x00 || utf8(canonical leaf));
// once `anchorId` is set the leaf is frozen into an on-ledger Merkle root.
model ScreeningReceipt {
  queryId        String   @id                  // UUIDv4
  subjectAddress String
  requestedBy    String                        // "key:<keyPrefix>" | "x402:<paymentId>" | "mcp" | "public"
  screenedAt     DateTime                      // instant of the comparison (ms precision; also in the leaf)
  method         String   @default("exact-match")
  ledgerIndex    Int      @default(0)          // validated ledger index pinned at screen time; 0 if unknown
  listsJson      Json                          // canonical lists[]: [{ name, vintage, sha256 }]
  resultJson     Json                          // canonical result: { listed } | { listed, matches[] }
  engineVersion  String                        // "sanction-screen-v1" — IMMUTABLE per receipt
  canonVersion   String   @default("ofac-screen-v1")
  leafHash       String                        // 64-hex
  snapshotId     String                        // the SanctionListSnapshot this screen ran against
  anchorId       String?
  anchor         ScreeningAnchor? @relation(fields: [anchorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([subjectAddress])
  @@index([anchorId])
  @@index([createdAt])
}

// One daily Merkle anchor over a batch of receipts. Same wallet + scheme as
// MptAnchor; separate memo type and batch.
model ScreeningAnchor {
  id           String   @id @default(cuid())
  canonVersion String                          // "ofac-screen-v1"
  merkleRoot   String                          // 64-hex
  leafCount    Int
  rangeStart   DateTime?
  rangeEnd     DateTime?
  memo         String                          // exact UTF-8 memo payload written on-ledger
  txHash       String?  @unique
  ledgerIndex  Int?
  account      String?
  feeDrops     String?
  closeTime    DateTime?                       // ledger close time of the anchor tx
  status       String   @default("pending")    // pending | anchored | failed | misconfigured | superseded
  error        String?
  createdAt    DateTime @default(now())
  anchoredAt   DateTime?

  receipts     ScreeningReceipt[]

  @@index([status])
  @@index([createdAt])
}

// ─── XLS-66 cross-broker lending exposure — the credit file the ledger can't keep ──
// XLS-66 stores CURRENT exposure only. A defaulted Loan zeroes its own amounts
// (only lsfLoanDefault persists) and either party may LoanDelete a paid/defaulted
// Loan to reclaim the borrower's reserve — so a borrower can erase the evidence of
// their own default. Our snapshots ARE the credit history. Every exposure query
// persists one immutable LendingExposureSnapshot; LendingLoanObservation is a
// per-(borrower,loan) tracker built from those snapshots that only ever
// ACCUMULATES (first-observed never changes, ever-flags are monotonic, a
// disappearance is recorded once). Nothing here is ever pruned or overwritten.

// One row per exposure query. IMMUTABLE — append only.
model LendingExposureSnapshot {
  id               String   @id @default(cuid())
  queryId          String   @unique                 // also the attestation receipt id
  borrower         String
  ledgerIndex      Int
  ledgerCloseAt    DateTime?
  amendmentActive  Boolean
  observedAt       DateTime @default(now())          // wall clock at query time
  loanCount        Int      @default(0)              // loans visible at this ledger
  brokerCount      Int      @default(0)
  worstStatus      String   @default("none")
  exposureByAsset  Json                              // { assetKey: { principalOutstanding, totalValueOutstanding, loanCount } }
  events           Json                              // { defaulted, impaired, overdue, overdueGraceExpired }
  visibleLoanIds   Json                              // sorted string[] — exactly which Loan objects were on the ledger
  loans            Json                              // full per-loan detail array (the raw observation)
  earliestNextPaymentDueAt DateTime?
  xrplScore        Int?
  grade            String?
  requestedBy      String                            // "key:<prefix>" | "x402:<id>" | "mcp"
  canonVersion     String   @default("lending-exposure-v1")
  engineVersion    String   @default("lending-exposure-v1")
  leafHash         String
  anchorId         String?
  anchor           LendingExposureAnchor? @relation(fields: [anchorId], references: [id])
  createdAt        DateTime @default(now())

  @@index([borrower, observedAt])
  @@index([anchorId])
  @@index([createdAt])
}

// Per-(borrower, loanId) lifecycle tracker. A materialized view over
// LendingExposureSnapshot — rebuildable from it, and only ever accumulates
// knowledge. `disappearedAt` is set once, when a previously-seen loan is absent
// from a fresh query (the borrower or broker deleted it).
model LendingLoanObservation {
  id                    String   @id @default(cuid())
  borrower              String
  loanId                String                       // the Loan object's ledger index (64-hex)
  loanBrokerId          String
  brokerOwner           String?
  asset                 String?                      // resolved Vault.Asset key
  firstObservedAt       DateTime                     // IMMUTABLE once set
  firstObservedLedger   Int
  lastObservedAt        DateTime
  lastObservedLedger    Int
  observationCount      Int      @default(1)
  lastKnownStatus       String                       // current | overdue | overdueGraceExpired | impaired | defaulted | paid
  lastKnownPrincipal    String?
  lastKnownTotalValue   String?
  everImpaired          Boolean  @default(false)     // monotonic
  everDefaulted         Boolean  @default(false)     // monotonic
  everOverdue           Boolean  @default(false)     // monotonic
  disappearedAt         DateTime?                    // set ONCE — loan no longer on the ledger
  disappearedAfterLedger  Int?                       // last ledger we saw it
  disappearedBeforeLedger Int?                       // first ledger we confirmed it gone
  reappearedAt          DateTime?                    // should never happen post-LoanDelete; recorded if it does
  createdAt             DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([borrower, loanId])
  @@index([borrower])
  @@index([everDefaulted])
}

// The daily-sweep work-list: one row per borrower XRPLHub has ever observed.
// The sweep re-observes every borrower every day so the attested history has no
// gaps where nobody happened to run a paid query. `hasActiveOrImpaired` is the
// priority signal — those borrowers' evidence is most likely to be deleted, so
// they are swept first. `lastSweptAt` / `lastSweptPass` drive stalest-first
// round-robin and let a pass resume across cron windows without skipping anyone.
model LendingBorrowerSweep {
  borrower             String   @id
  firstObservedAt      DateTime                       // first observation of this borrower, any source
  addedToSweepAt       DateTime @default(now())
  lastObservedAt       DateTime                       // last observation, any source (sweep or paid query)
  lastSweptAt          DateTime?                      // last SWEEP observation specifically
  lastSweptLedger      Int?
  lastSweptPass        Int      @default(0)
  sweepCount           Int      @default(0)
  hasActiveOrImpaired  Boolean  @default(false)       // priority — refreshed on every observation
  lastKnownWorstStatus String   @default("none")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([hasActiveOrImpaired, lastSweptAt])
  @@index([lastSweptPass])
}

// One lending-underwriting-inputs bundle (underwrite-bundle-v1). FACTS ONLY —
// composes an exposure snapshot, an OFAC screening receipt, the XRPLScore and
// the observation summary. Carries no recommendation. The leaf commits to the
// component leaf hashes; each component is also independently verifiable.
model UnderwriteBundleReceipt {
  queryId          String   @id
  borrower         String
  ledgerIndex      Int
  requestedBy      String
  exposureQueryId  String
  screeningQueryId String?
  xrplScore        Int?
  screeningListed  Boolean  @default(false)
  worstStatus      String   @default("none")
  leafJson         Json
  leafHash         String
  canonVersion     String   @default("underwrite-bundle-v1")
  engineVersion    String   @default("underwrite-bundle-v1")
  anchorId         String?
  anchor           UnderwriteBundleAnchor? @relation(fields: [anchorId], references: [id])
  createdAt        DateTime @default(now())

  @@index([borrower, createdAt])
  @@index([anchorId])
  @@index([createdAt])
}

model UnderwriteBundleAnchor {
  id           String   @id @default(cuid())
  canonVersion String
  merkleRoot   String
  leafCount    Int
  rangeStart   DateTime?
  rangeEnd     DateTime?
  memo         String
  txHash       String?  @unique
  ledgerIndex  Int?
  account      String?
  feeDrops     String?
  closeTime    DateTime?
  status       String   @default("pending")
  error        String?
  createdAt    DateTime @default(now())
  anchoredAt   DateTime?

  receipts     UnderwriteBundleReceipt[]

  @@index([status])
  @@index([createdAt])
}

// One daily Merkle anchor over a batch of exposure snapshots. Same wallet + hash
// scheme as ScreeningAnchor / MptAnchor; separate memo type + batch.
model LendingExposureAnchor {
  id           String   @id @default(cuid())
  canonVersion String
  merkleRoot   String
  leafCount    Int
  rangeStart   DateTime?
  rangeEnd     DateTime?
  memo         String
  txHash       String?  @unique
  ledgerIndex  Int?
  account      String?
  feeDrops     String?
  closeTime    DateTime?
  status       String   @default("pending")          // pending | anchored | failed | misconfigured | superseded
  error        String?
  createdAt    DateTime @default(now())
  anchoredAt   DateTime?

  snapshots    LendingExposureSnapshot[]

  @@index([status])
  @@index([createdAt])
}
